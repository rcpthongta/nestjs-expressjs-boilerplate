{
  "version": "1.0.0",
  "name": "nestjs-expressjs-boilerplate",
  "description": "A minimal NestJS boilerplate using Express.js and Webpack (with SWC), preconfigured for RESTful APIs. Ideal as a starting point for scalable backend applications.",
  "author": "rcpthongta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcpthongta/nestjs-expressjs-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/rcpthongta/nestjs-expressjs-boilerplate/issues"
  },
  "private": true,
  "engines": {
    "node": "^22",
    "npm": "^10"
  },
  "scripts": {
    "install:husky": "husky",
    "precommit": "lint-staged",
    "prepush": "npm run test:unit && npm run test:integration",
    "preenv:gen-example": "del \".\\environments\\.env.example\"",
    "build": "cross-env NODE_ENV=development nest build",
    "build:staging": "cross-env NODE_ENV=staging nest build",
    "build:production": "cross-env NODE_ENV=production nest build",
    "dev": "dotenvx run -f \".\\environments\\.env.development\" -- cross-env NODE_ENV=development nest start -w",
    "dev:debug": "dotenvx run -f \".\\environments\\.env.development\" -- cross-env NODE_ENV=development nest start -d -w",
    "dev:docs": "npx compodoc -c \".\\.compodocrc\"",
    "env:gen-example": "dotenvx ext genexample ./environments -f \".\\.env.development\"",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "jest",
    "test:unit-watch": "jest --watch",
    "test:unit-coverage": "jest --coverage",
    "test:integration": "jest --config \".\\jest-integration.config.mjs\"",
    "test:integration-watch": "jest --config \".\\jest-integration.config.mjs\" --watch",
    "test:integration-coverage": "jest --config \".\\jest-integration.config.mjs\" --coverage",
    "test:e2e": "jest --config \".\\e2e\\jest-e2e.config.mjs\"",
    "test:e2e-watch": "jest --config \".\\e2e\\jest-e2e.config.mjs\" --watch",
    "lint": "eslint **\\*.{*rc,cjs,js,json,json5,jsonc,jsonl,md,mjs,ts,yaml,yml}",
    "lint:fix": "eslint --fix **\\*.{*rc,cjs,js,json,json5,jsonc,jsonl,md,mjs,ts,yaml,yml}"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "1.49.0",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/throttler": "6.4.0",
    "joi": "18.0.1",
    "morgan": "1.10.1",
    "nanoid": "5.1.5",
    "nest-winston": "1.10.2",
    "nestjs-cls": "6.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "winston": "3.17.0",
    "winston-daily-rotate-file": "5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@compodoc/compodoc": "1.1.30",
    "@eslint/js": "9.35.0",
    "@eslint/markdown": "7.2.0",
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.1.6",
    "@suites/di.nestjs": "3.0.1",
    "@suites/doubles.jest": "3.0.1",
    "@suites/unit": "3.0.1",
    "@swc/cli": "0.7.8",
    "@swc/core": "1.13.5",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/morgan": "1.9.10",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.1",
    "@types/source-map-support": "0.5.10",
    "@types/supertest": "6.0.3",
    "copy-webpack-plugin": "13.0.1",
    "cross-env": "10.0.0",
    "del-cli": "6.0.0",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsonc": "2.20.1",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-unused-imports": "4.2.0",
    "eslint-plugin-yml": "1.18.0",
    "eslint-webpack-plugin": "5.0.2",
    "globals": "16.3.0",
    "husky": "9.1.7",
    "jest": "30.1.3",
    "jsonc-eslint-parser": "2.4.0",
    "lint-staged": "16.1.6",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "swc-loader": "0.2.6",
    "terser-webpack-plugin": "5.3.14",
    "ts-jest": "29.4.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.42.0",
    "webpack": "5.101.3",
    "webpack-cli": "6.0.1",
    "yaml-eslint-parser": "1.3.0"
  }
}
